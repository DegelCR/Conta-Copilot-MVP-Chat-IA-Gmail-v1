# Supabase — URL del proyecto (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Supabase — clave pública anon (Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Supabase — clave service_role (Settings → API → service_role)
# Solo para scripts/server; nunca expongas en el navegador ni en el cliente.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# OpenAI — extracción de facturas y chat contable
OPENAI_API_KEY=sk-proj-tu_key_aqui

# URL pública de la app (opcional; default http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth — Gmail (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Cifrado de tokens Gmail en DB (generar: openssl rand -base64 32)
GMAIL_TOKEN_ENCRYPTION_KEY=
